{
  "g1d.dual_arm.plan_pose": {
    "tool_id": "g1d.dual_arm.plan_pose",
    "semantics": "query",
    "endpoint_id": "g1d.dual_arm",
    "operation": "plan_pose",
    "description": "Plan bilateral arm poses without motion. For a raised greeting use gesture=wave and gesture_arm=left or right (default right), with both observed poses as input. The Runtime solves the greeting with IK, holds the other arm, waves continuously and returns to the starting joints.",
    "max_concurrency": 8,
    "robot_frame_profile": {
      "base_frame": "unirobot_g1d_fixed_base",
      "tool_frame": "tcp",
      "position_unit": "m",
      "orientation": "normalized_xyzw",
      "position_tolerance_m": 0.02,
      "orientation_tolerance_deg": 5
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/target"
        },
        "right": {
          "$ref": "#/$defs/target"
        },
        "deadline_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "gesture": {
          "type": "string",
          "enum": ["wave"]
        },
        "gesture_arm": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "right",
          "description": "Arm performing gesture=wave; the other arm holds its measured joints."
        }
      },
      "allOf": [
        {
          "if": {"required": ["gesture_arm"]},
          "then": {"required": ["gesture"], "properties": {"gesture": {"const": "wave"}}}
        }
      ],
      "$defs": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_id",
            "position_m",
            "orientation_xyzw"
          ],
          "properties": {
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "position_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "orientation_xyzw": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "dex1": {
              "$ref": "#/$defs/dex1"
            }
          }
        },
        "dex1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "opening"
          ],
          "properties": {
            "opening": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "expires_at",
        "binding"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill_version",
            "runtime_instance_id",
            "target_digest"
          ],
          "properties": {
            "skill_version": {
              "type": "string"
            },
            "runtime_instance_id": {
              "type": "string"
            },
            "target_digest": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "g1d.dual_arm.execute_pose": {
    "tool_id": "g1d.dual_arm.execute_pose",
    "semantics": "action",
    "endpoint_id": "g1d.dual_arm",
    "operation": "execute_pose",
    "description": "Execute one validated bilateral plan as an atomic physical Action.",
    "max_concurrency": 1,
    "robot_frame_profile": {
      "base_frame": "unirobot_g1d_fixed_base",
      "tool_frame": "tcp",
      "position_unit": "m",
      "orientation": "normalized_xyzw",
      "position_tolerance_m": 0.02,
      "orientation_tolerance_deg": 5
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_deadline_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "caller_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "attempt_id"
      ],
      "properties": {
        "invocation_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        }
      }
    }
  },
  "g1d.dual_arm.state": {
    "tool_id": "g1d.dual_arm.state",
    "semantics": "query",
    "endpoint_id": "g1d.dual_arm",
    "operation": "state",
    "description": "Read current bilateral arm, safety, and external Dex1 readiness state.",
    "max_concurrency": 8,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_ready",
        "action_ready"
      ],
      "properties": {
        "runtime_ready": {
          "type": "boolean"
        },
        "runtime_instance_id": {"type": "string", "minLength": 1},
        "skill_version": {"type": "string", "minLength": 1},
        "action_ready": {
          "type": "boolean"
        },
        "state_age_ms": {
          "type": "number"
        },
        "end_effector_poses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {"$ref": "#/$defs/observed_pose"},
            "right": {"$ref": "#/$defs/observed_pose"}
          }
        },
        "safety_gate": {
          "type": "string"
        },
        "dex1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "healthy",
                    "absent",
                    "stale"
                  ]
                },
                "opening": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "age_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "right": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "healthy",
                    "absent",
                    "stale"
                  ]
                },
                "opening": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "age_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "gripper_control": {"type": "object", "description": "Per-side command_active, target_opening, commanded_opening and refresh fault. Feedback can be healthy while commands are inactive."},
        "mode_machine": {
          "type": "integer"
        },
        "left_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "joint_positions_rad"
          ],
          "properties": {
            "joint_positions_rad": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "right_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "joint_positions_rad"
          ],
          "properties": {
            "joint_positions_rad": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "$defs": {
        "observed_pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame_id", "position_m", "orientation_xyzw"],
          "properties": {
            "frame_id": {"const": "unirobot_g1d_fixed_base"},
            "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
            "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
          }
        }
      }
    }
  },
  "g1d.dual_arm.plan_gripper": {
    "tool_id": "g1d.dual_arm.plan_gripper",
    "semantics": "query", "endpoint_id": "g1d.dual_arm", "operation": "plan_gripper",
    "description": "Plan left and/or right Dex1 opening (0 closed, 1 open); omitted gripper unchanged. Holds both measured arm joint positions exactly, without IK. Execute returned plan_id with execute_pose. Success means measured opening, not object grasp/contact. Commands ramp and persist while the physical TUI session is active.",
    "max_concurrency": 8,
    "input_schema": {"type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"left": {"type": "number", "minimum": 0, "maximum": 1},
                     "right": {"type": "number", "minimum": 0, "maximum": 1}}},
    "output_schema": {"type": "object", "additionalProperties": false,
      "required": ["plan_id", "expires_at", "binding"],
      "properties": {"plan_id": {"type": "string"}, "expires_at": {"type": "string"},
        "binding": {"type": "object", "additionalProperties": false,
          "required": ["skill_version", "runtime_instance_id", "target_digest"],
          "properties": {"skill_version": {"type": "string"}, "runtime_instance_id": {"type": "string"},
                         "target_digest": {"type": "string"}}}}}
  },
  "g1d.dual_arm.camera_state": {
    "tool_id": "g1d.dual_arm.camera_state",
    "semantics": "query", "endpoint_id": "g1d.dual_arm", "operation": "camera_state",
    "description": "Inspect TeleImager head, left wrist and right wrist stream freshness and spatial calibration availability. A missing camera does not block arms/grippers.",
    "max_concurrency": 8,
    "input_schema": {"type": "object", "additionalProperties": false, "properties": {}},
    "output_schema": {"type": "object", "required": ["cameras", "spatial_targeting_ready"],
      "properties": {"cameras": {"type": "object"}, "error": {"type": ["string", "null"]},
        "spatial_targeting_ready": {"const": false}, "spatial_targeting_reason": {"type": "string"}},
      "additionalProperties": false}
  },
  "g1d.dual_arm.camera_observe": {
    "tool_id": "g1d.dual_arm.camera_observe",
    "semantics": "query", "endpoint_id": "g1d.dual_arm", "operation": "camera_observe",
    "description": "Acquire a new head/left_wrist/right_wrist JPEG and analyze its actual pixels through PAOS multimodal vision. Optional question directs visual inspection. Read outputs.vision; failed vision is not seeing. Local receive time is not camera exposure time. RGB has no verified metric depth or robot extrinsics: do not invent grasp coordinates.",
    "max_concurrency": 1,
    "input_schema": {"type": "object", "additionalProperties": false,
      "properties": {"camera": {"type": "string", "enum": ["head", "left_wrist", "right_wrist"], "default": "head"},
        "question": {"type": "string", "maxLength": 2000}}},
    "output_schema": {"type": "object", "additionalProperties": false,
      "required": ["camera", "frame_id", "image", "width", "height", "received_at_unix_s", "receive_age_ms", "timestamp_basis", "capture_timestamp_available", "binocular", "spatial_targeting_ready"],
      "properties": {"camera": {"type": "string"}, "frame_id": {"type": "string"},
        "image": {"type": "object", "additionalProperties": false, "required": ["path", "mime_type", "sha256"],
          "properties": {"path": {"type": "string"}, "mime_type": {"const": "image/jpeg"}, "sha256": {"type": "string"}}},
        "width": {"type": "integer"}, "height": {"type": "integer"},
        "received_at_unix_s": {"type": "number"}, "receive_age_ms": {"type": "number"},
        "timestamp_basis": {"const": "local_receive_only"}, "capture_timestamp_available": {"const": false},
        "binocular": {"type": "boolean"}, "spatial_targeting_ready": {"const": false}}}
  },
  "g1d.dual_arm.stop": {
    "tool_id": "g1d.dual_arm.stop",
    "semantics": "action",
    "endpoint_id": "g1d.dual_arm",
    "operation": "stop",
    "description": "Idempotently request a controlled stop for the active bilateral Action.",
    "max_concurrency": 1,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "already_stopped",
            "unknown"
          ]
        }
      }
    }
  }
}
